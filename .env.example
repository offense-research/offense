# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
PUBLIC_URL=http://localhost:3217
PORT=3217
HOST=127.0.0.1
DEFAULT_COMPANY=
DATA_DIR=

# Cloudflare OAuth client (public visibility is required for external customers)
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=
CLOUDFLARE_SCOPES=account-settings.read workers-scripts.read workers-scripts.write queues.write

# Public HTTPS endpoint that routes to POST /api/ingest (Cloudflare Workers cannot reach a private tailnet URL)
PURPLE_INGEST_URL=

# ClickHouse HTTPS endpoint (the app creates its log table on first use)
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=purple_events
# Staging Worker deployments use separate STAGING_CLICKHOUSE_* settings.
# Leave these unset to keep staging on its SQLite search fallback.
# STAGING_CLICKHOUSE_URL=
# STAGING_CLICKHOUSE_USER=
# STAGING_CLICKHOUSE_PASSWORD=
# STAGING_CLICKHOUSE_DATABASE=default
# STAGING_CLICKHOUSE_TABLE=purple_events_staging

# GitHub App settings; configure setup URL and callback URL in GitHub
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local Node development uses Docker; production uses purple-agent on Cloudflare Containers.
PURPLE_AGENT_MODEL=deepseek/deepseek-v4.1-flash
PURPLE_AGENT_IMAGE=purple-pi-agent:0.2

# Optional one-time, private owner link for GitHub App manifest registration
GITHUB_MANIFEST_SETUP_TOKEN=

# Optional hosted agent service for source scans and upgrade rehearsals (local Node API).
# Production reuses the existing Worker bindings with these names.
PURPLE_AGENT_URL=
PURPLE_AGENT_SHARED_KEY=

# Hosted model Whop billing is separate from scanner credit. Keep it disabled
# until that model checkout and webhook flow are verified. Model balance: $5
# top-up; actual OpenRouter usage + 30%. Discovery scans and BYOK stay free.
# Platform key for hosted paid model planning (never exposed to browsers or sandboxes).
OPENROUTER_API_KEY=
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_BILLING_ENABLED=false
WHOP_SANDBOX=false

# Separate prepaid scanner credit: $10 Whop loads and prices for all 12 tool IDs.
# Enabling requires WHOP_API_KEY, the scanner-specific webhook secret, and a JSON map
# with {"baseMicros":50000,"additionalMiBMicros":10000} per tool; see
# docs/scanner-pricing.md for the complete provisional rate card.
SCAN_BILLING_ENABLED=false
SCAN_WHOP_WEBHOOK_SECRET=
SCAN_TOOL_PRICES_JSON=
# Enable only assessment images and egress paths verified on this deployment.
SCAN_ASSESSMENT_TOOLS_JSON=[]
# Agent Worker only: an HTTPS gateway on a non-Workers host for raw TLS egress.
ASSESSMENT_EGRESS_URL=
ASSESSMENT_EGRESS_KEY=

# Optional issue tracking: owner-managed OAuth apps (production values belong in Infisical)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Optional: disable privacy-minimized server diagnostics. Never records request
# bodies, identities, source, headers, or free-form error text in these traces.
OFFENSE_TRACE_ENABLED=true
